# --- Client-safe feature flag ---
# This IS bundled into the client build (Vite exposes all VITE_-prefixed
# vars to the browser), but it's just a boolean, not a secret. Leave unset
# or "false" to keep using the local heuristic analysis provider (default —
# no cost, no key, works fully offline). Only set to "true" after the
# /api/analyze serverless endpoint below is actually deployed and configured.
VITE_ENABLE_AI_ANALYSIS=false

# --- Server-side only secret — do NOT prefix with VITE_ ---
# Read exclusively by api/analyze.js, which runs server-side (a serverless
# function once deployed). Vite never sees or bundles non-VITE_-prefixed
# variables, so this can never leak into the browser. Set this in your
# hosting platform's project environment settings (e.g. Vercel/Netlify),
# not in a file that ships with the app. Leave unset for now — the app
# works completely without it.
# ANTHROPIC_API_KEY=
